{
    "version": 2,
    "configurePresets": [
        {
            "name": "vs2026-x64",
            "displayName": "Visual Studio 2026 (x64)",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/vs2026",
            "cacheVariables": {
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "ENABLE_CTEST": "OFF",
                "BUILD_TESTING": "OFF",
                "USE_DX9": "OFF",
                "USE_HOST_SDL": "OFF"
            }
        },
        {
            "name": "clang",
            "generator": "Ninja",
            "binaryDir": "build-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "gcc",
            "generator": "Ninja",
            "binaryDir": "build-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2026-release",
            "configurePreset": "vs2026-x64",
            "configuration": "Release",
            "targets": ["flycast"],
            "jobs": 1,
            "nativeToolOptions": ["/nodeReuse:false"]
        },
        {
            "name": "vs2026-debug",
            "configurePreset": "vs2026-x64",
            "configuration": "Debug",
            "targets": ["flycast"],
            "jobs": 1,
            "nativeToolOptions": ["/nodeReuse:false"]
        }
    ]
}
